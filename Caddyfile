# Reverse proxy del VPS — dominio real: api.aeis-app.online (comprado para
# el backend; el subdominio "api." deja la raíz libre para una futura
# landing/marketing page). Caddy emite y renueva el certificado de Let's
# Encrypt solo, sin cron ni certbot, en cuanto el DNS resuelva hacia esta
# instancia (ver docs/dominio/10-despliegue-vps-vercel.md §1.2).
#
# Requisito previo en el proveedor de DNS del dominio: un registro A
#   api.aeis-app.online  →  <IP pública de la instancia OCI>
# (y opcionalmente AAAA si la instancia tiene IPv6). Sin ese registro
# resuelto, Caddy no puede completar el challenge HTTP-01 de Let's Encrypt
# y esta instancia sigue exponiendo lo que tenía antes.
api.aeis-app.online {
	reverse_proxy backend:3000

	# El backend ya limita origins vía FRONTEND_ORIGIN (CORS) y ya trae
	# Helmet — Caddy no duplica esas cabeceras, solo reenvía.
	encode gzip
}
