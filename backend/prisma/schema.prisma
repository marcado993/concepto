// AEIS-APP — esquema de datos
//
// Principio rector (docs/dominio/05-metodologia-devsecops-pipeline.md §3.1):
// "ningún dato desacoplado" — todo pago, alquiler y aportación tiene una
// llave foránea NOT NULL real a su dueño y a su contexto de negocio. La
// base de datos rechaza el registro huérfano aunque la app tenga un bug;
// esto es lo que habría hecho visible, no oculto, el déficit de caja de
// 01-analisis-negocio-mision.md §2.1 (277 registros → 91 concretados, sin
// rastro de los otros 186).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ESTUDIANTE
  PRESIDENTE
  DIRECTOR
}

enum LockerStatus {
  AVAILABLE
  RESERVED // pago iniciado, esperando confirmación (transferencia+OCR o PayPhone pendiente)
  RENTED
}

enum PaymentMethod {
  PAYPHONE
  TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id         String   @id @default(uuid())
  logtoSub   String   @unique // subject claim del JWT de Logto — nunca la cédula como PK (ver aeis-app/docs §6)
  uniqueCode String   @unique // código único de estudiante EPN
  // Correo con el que entró. Se guarda por una razón concreta del flujo de
  // login, no por gusto: Logto exige elegir ANTES de mandar el código si la
  // interacción es "iniciar sesión" o "crear cuenta" (su enum solo acepta
  // SignIn | Register), y cambiar de una a otra a mitad DESTRUYE la
  // verificación (comprobado contra el tenant real:
  // session.verification_session_not_found). Sin saber de antemano si el
  // correo ya existe, había que adivinar y, al fallar, pedir un segundo
  // código — de ahí los DOS correos que recibía quien se registraba por
  // primera vez. Esta columna es la que permite acertar al primer intento.
  email      String?  @unique
  fullName   String
  role       Role     @default(ESTUDIANTE)
  // Cédula/celular — se piden UNA vez (al primer alquiler de casillero,
  // ver locker.controller.ts) y se guardan acá para no volver a
  // preguntarlos en el siguiente semestre (heurística de Nielsen:
  // reconocimiento sobre recuerdo). Nulos hasta ese primer alquiler.
  cedula     String?
  phone      String?
  createdAt  DateTime @default(now())

  payments      Payment[]
  rentals       LockerRental[]
  subscriptions Subscription[]
  auditLogs     AuditLog[] @relation("AuditActor")
  ventures      Venture[]

  @@map("users")
}

enum VentureStatus {
  PENDING // recién enviado, no visible en el directorio público todavía
  APPROVED
  REJECTED
}

// Emprendimientos — reemplaza el dominio "Comunidad" del prototipo original
// (docs/dominio/01-analisis-negocio-mision.md §4): vitrina/directorio +
// contacto por WhatsApp, SIN chat propio ni pago in-app (ver
// aeis-app/docs/arquitectura-nuevos-modulos.md §3.4, diseño reutilizado
// tal cual). El número de WhatsApp no se expone crudo al público — el
// controller arma el link wa.me server-side (VentureController).
model Venture {
  id              String        @id @default(uuid())
  ownerId         String
  owner           User          @relation(fields: [ownerId], references: [id])
  name            String
  description     String
  category        String
  photoUrl        String?
  whatsappNumber  String
  status          VentureStatus @default(PENDING)
  createdAt       DateTime      @default(now())

  @@index([status])
  @@map("ventures")
}

model Period {
  id        String   @id @default(uuid())
  label     String   @unique // ej. "2026-A"
  startsAt  DateTime
  endsAt    DateTime
  // Precio base del casillero para ESTE periodo — antes era la constante
  // DEFAULT_LOCKER_BASE_PRICE ($6.50) escrita a mano en locker.service.ts,
  // sin forma de que la directiva la cambiara sin un redeploy. El sponsor
  // puede fijar cualquier valor entre $5.50 y $9.00 según la utilidad
  // objetivo (docs/dominio/03-analisis-financiero-costos.md §4/§8.7) — eso
  // es una decisión de negocio por semestre, igual que el monto de cada
  // SubscriptionTier de abajo, así que vive en la misma tabla que ya
  // representa "las condiciones económicas de este periodo".
  lockerBasePrice Decimal  @default(6.50) @db.Decimal(10, 2)

  rentals            LockerRental[]
  subscriptionTiers  SubscriptionTier[]
  subscriptions      Subscription[]

  @@map("periods")
}

model Locker {
  id     String       @id @default(uuid())
  code   String       @unique // ej. "A07"
  zone   String
  status LockerStatus @default(AVAILABLE)

  rentals LockerRental[]

  @@map("lockers")
}

model Payment {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  providerRef String? // id de transacción de PayPhone, o nombre de archivo del comprobante
  createdAt   DateTime      @default(now())
  confirmedAt DateTime?

  rental       LockerRental?
  subscription Subscription?

  @@map("payments")
}

model LockerRental {
  id        String   @id @default(uuid())
  lockerId  String
  locker    Locker   @relation(fields: [lockerId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  periodId  String
  period    Period   @relation(fields: [periodId], references: [id])
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  createdAt DateTime @default(now())

  // Un mismo casillero no puede tener dos alquileres activos en el mismo
  // periodo — es la restricción de base de datos detrás del escenario BDD
  // "condición de carrera" de 05-metodologia-devsecops-pipeline.md §2.
  @@unique([lockerId, periodId])
  @@map("locker_rentals")
}

model SubscriptionTier {
  id       String   @id @default(uuid())
  periodId String
  period   Period   @relation(fields: [periodId], references: [id])
  name     String // "Bronce" | "Platino" | "Pantera" — ver nota de montos abajo
  amount   Decimal  @db.Decimal(10, 2)
  benefits Json // estructura libre: [{ "type": "descuento_casillero", "value": 0 }, ...]

  subscriptions Subscription[]

  // El mismo nombre de tier no se repite dentro de un periodo, pero SÍ puede
  // tener montos/beneficios distintos entre periodos — el histórico real ya
  // cambió de esquema una vez (03-analisis-financiero-costos.md §3).
  @@unique([periodId, name])
  @@map("subscription_tiers")
}

model Subscription {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  tierId    String
  tier      SubscriptionTier    @relation(fields: [tierId], references: [id])
  periodId  String
  period    Period              @relation(fields: [periodId], references: [id])
  paymentId String              @unique
  payment   Payment             @relation(fields: [paymentId], references: [id])
  status    SubscriptionStatus  @default(ACTIVE)
  createdAt DateTime            @default(now())

  @@unique([userId, periodId]) // un aportante tiene un solo tier activo por periodo
  @@map("subscriptions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // ej. "locker.rental.created", "subscription.created"
  entityType String // ej. "LockerRental"
  entityId   String
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
