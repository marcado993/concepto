# Copiar a .env — nunca commitear el .env real (ya cubierto por
# policy/semgrep-rules.yml + Gitleaks en el pipeline).

DATABASE_URL="postgresql://user:password@localhost:5432/aeis_app?schema=public"

# Modo de despliegue de Logto (cloud vs. self-hosted) sigue como pregunta
# abierta — docs/dominio/02-necesidades-stakeholders.md §4 #5. En cualquiera
# de los dos casos, LOGTO_ISSUER es la URL base de tu instancia/tenant.
LOGTO_ISSUER="https://<tu-tenant>.logto.app/oidc"
LOGTO_AUDIENCE="https://api.aeis-app.example"

# App de tipo "Traditional Web" en Logto (no SPA) — el backend hace el
# intercambio de código, por eso necesita client_secret. Requiere tener
# habilitado el conector social de GitHub en el tenant de Logto.
LOGTO_APP_ID="<app-id-de-logto>"
LOGTO_APP_SECRET="<app-secret-de-logto>"
LOGTO_REDIRECT_URI="https://api.aeis-app.example/auth/callback"

# Firma la cookie de PKCE (backend/src/shared/auth/auth.controller.ts) —
# generar con `openssl rand -base64 32`, nunca reutilizar entre entornos.
COOKIE_SECRET="<valor-aleatorio-largo>"

# Cajita de Pagos de PayPhone (payphonetodoesposible.com) — se obtienen en
# Payphone Developer creando una app tipo "WEB" con el dominio real de
# producción y una URL de respuesta que apunte a la raíz del frontend
# (PayPhone redirige ahí con ?id=&clientTransactionId= tras el pago). Sin
# estos dos valores, GET /lockers/payphone/config responde
# configured:false y el frontend deshabilita esa opción de pago.
PAYPHONE_TOKEN="<token-de-payphone-developer>"
PAYPHONE_STORE_ID="<storeid-de-payphone-developer>"

# Alertas de CPU/memoria (shared/monitoring) — una o más URLs separadas por
# coma, cada una recibe un POST JSON {text, severity, source, at}.
# Recomendado para celular: crea un topic privado en https://ntfy.sh (sin
# registro) y suscríbete desde la app de ntfy — la URL es
# https://ntfy.sh/<tu-topic-secreto>. Para correo, cualquier automatización
# que reciba ese mismo POST y reenvíe por email sirve igual.
ALERT_WEBHOOK_URLS="https://ntfy.sh/<tu-topic-secreto>"

# Origen(es) del frontend en Vercel, separados por coma — nunca "*" (el
# backend maneja pagos y datos biométricos).
FRONTEND_ORIGIN="https://aeis-app.vercel.app"

PORT=3000

# Poner en "true" SOLO si el backend corre detrás de un reverse proxy
# conocido (Nginx/Caddy en el mismo VPS) — de lo contrario, X-Forwarded-For
# se puede falsificar y rompe tanto el rate limiting por IP como el
# ipAddress del AuditLog.
TRUST_PROXY=false
