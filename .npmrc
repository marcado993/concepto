# Vercel/npm: el árbol NO tiene ningún conflicto real de peers (se auditó:
# ningún paquete rechaza TypeScript 6). El ERESOLVE en Vercel salía solo
# porque "npm install" re-resolvía svelte-check ^4.7.3 -> 4.7.6 y su
# resolvedor estricto marcaba typescript@6.0.3 como "peer en conflicto"
# aunque 6.0.3 SÍ satisface su rango (^5 || ^6). legacy-peer-deps usa la
# resolución no estricta (npm v6) para que el install no falle por ese
# falso positivo — no relaja ninguna incompatibilidad real.
legacy-peer-deps=true

# Defensa de cadena de suministro (la exige la regla
# npm-missing-minimum-release-age del escaneo SAST, y con razón): no
# resolver versiones publicadas hace menos de 7 días. El patrón real de los
# ataques a npm es publicar una versión maliciosa de un paquete secuestrado
# y que los CI la instalen en cuestión de horas; esperar una semana da
# tiempo a que se detecte y despublique. No afecta a las versiones ya
# fijadas en package-lock.json, solo a resolver rangos hacia algo nuevo.
min-release-age=7
